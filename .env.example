# ===== BazarDor environment variables =====
# এই ফাইলটা copy করে .env.local নাম দাও, তারপর নিচের value গুলো বসাও।

# Bazar Dor API (দেওয়া আছে, বদলাতে হবে না)
NEXT_PUBLIC_API_URL=https://openapi.programming-hero.com/api/bazardor

# Better Auth
# এটা যেকোনো লম্বা random string হতে পারে (কমপক্ষে ৩২ অক্ষর)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Local এ: http://localhost:3000   |   Deploy এর পর: https://your-site.vercel.app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas (free) — users এর data এখানে save হবে
MONGODB_URI=
MONGODB_DB=bazardor

# Google login (Google Cloud Console থেকে পাবে)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub login (GitHub > Settings > Developer settings > OAuth Apps থেকে পাবে)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
